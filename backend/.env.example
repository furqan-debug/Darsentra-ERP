# Django Backend Environment Configuration
DJANGO_SECRET_KEY=change-me-in-production-random-secure-key-1234567890
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# For local development without Docker, setting DB_ENGINE=sqlite uses SQLite fallback automatically
DB_ENGINE=django.db.backends.postgresql
DB_NAME=darsentra_erp
DB_USER=darsentra_user
DB_PASSWORD=darsentra_dev_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration (Comma-separated allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
