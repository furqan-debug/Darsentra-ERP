<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_school_challan" model="report.paperformat">
        <field name="name">Darsentra School Challan Landscape</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_school_bank_challan" model="ir.actions.report">
        <field name="name">School Fee Challan (3-Part Slip)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">darsentra_school_fees.report_school_challan_document</field>
        <field name="report_file">darsentra_school_fees.report_school_challan_document</field>
        <field name="print_report_name">'Fee_Challan_' + (object.student_id.name or 'Student')</field>
        <field name="paperformat_id" ref="paperformat_school_challan"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
