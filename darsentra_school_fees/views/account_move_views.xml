<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_inherit_school_fees" model="ir.ui.view">
        <field name="name">account.move.form.inherit.school.fees</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(darsentra_school_fees.action_report_school_bank_challan)d"
                        string="Print 3-Part School Challan"
                        type="action"
                        class="btn-primary"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="School Fee Challan (1Link)" name="school_challan_page" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Student Enrollment">
                            <field name="is_school_fee"/>
                            <field name="billing_month"/>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="roll_number"/>
                            <field name="student_b_form"/>
                            <field name="father_name"/>
                            <field name="father_mobile"/>
                            <field name="class_id"/>
                            <field name="section_id"/>
                        </group>
                        <group string="Banking &amp; Discounts">
                            <field name="consumer_number" readonly="1"/>
                            <field name="bank_account_id" options="{'no_create': True}"/>
                            <field name="validity_date"/>
                            <field name="sibling_discount_percent"/>
                            <field name="sibling_discount_amount" readonly="1"/>
                            <field name="arrears_amount"/>
                            <field name="late_fee_surcharge"/>
                            <field name="total_with_late_fee" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Invoice List View for School Fee Search -->
    <record id="view_account_move_tree_inherit_school_fees" model="ir.ui.view">
        <field name="name">account.move.list.inherit.school.fees</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_partner_display_name'][last()]" position="after">
                <field name="student_id" optional="show"/>
                <field name="class_id" optional="show"/>
                <field name="section_id" optional="show"/>
                <field name="billing_month" optional="show"/>
                <field name="consumer_number" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
