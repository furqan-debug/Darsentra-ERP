<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="school_onboarding" name="Darsentra School Setup Onboarding">
        <t t-call="web.frontend_layout">
            <t t-set="title">School Setup — Darsentra ERP</t>

            <style>
                :root {
                    --ds-font: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                    --ds-slate-900: #0f172a;
                    --ds-slate-800: #1e293b;
                    --ds-slate-700: #334155;
                    --ds-slate-600: #475569;
                    --ds-slate-500: #64748b;
                    --ds-slate-400: #94a3b8;
                    --ds-slate-200: #e2e8f0;
                    --ds-slate-100: #f1f5f9;
                    --ds-slate-50: #f8fafc;
                    --ds-emerald: #047857;
                }

                body {
                    font-family: var(--ds-font);
                    color: var(--ds-slate-900);
                    background-color: var(--ds-slate-50);
                }

                /* Setup Page Container */
                .ds-onboarding-shell {
                    min-height: calc(100vh - 120px);
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    align-items: center;
                    padding: 48px 16px;
                }

                .ds-setup-card {
                    background: #ffffff;
                    border: 1px solid var(--ds-slate-200);
                    border-radius: 8px;
                    box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.05), 0 1px 2px -1px rgba(15, 23, 42, 0.05);
                    max-width: 580px;
                    width: 100%;
                    padding: 36px 40px;
                }

                .ds-setup-header {
                    margin-bottom: 28px;
                }
                .ds-setup-step {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    font-size: 0.75rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--ds-emerald);
                    margin-bottom: 8px;
                }
                .ds-setup-title {
                    font-size: 1.5rem;
                    font-weight: 700;
                    letter-spacing: -0.025em;
                    color: var(--ds-slate-900);
                    margin-bottom: 6px;
                }
                .ds-setup-subtitle {
                    font-size: 0.875rem;
                    line-height: 1.5;
                    color: var(--ds-slate-500);
                    margin-bottom: 0;
                }

                /* Form Controls */
                .ds-form-group {
                    margin-bottom: 20px;
                }
                .ds-label {
                    display: block;
                    font-size: 0.8125rem;
                    font-weight: 600;
                    color: var(--ds-slate-700);
                    margin-bottom: 6px;
                }
                .ds-input, .ds-select {
                    width: 100%;
                    border: 1px solid #cbd5e1;
                    border-radius: 6px;
                    padding: 9px 13px;
                    font-size: 0.9375rem;
                    color: var(--ds-slate-900);
                    background-color: #ffffff;
                    transition: border-color 0.15s ease, box-shadow 0.15s ease;
                }
                .ds-input:focus, .ds-select:focus {
                    border-color: var(--ds-slate-900);
                    outline: none;
                    box-shadow: 0 0 0 1px var(--ds-slate-900);
                }
                .ds-input::placeholder {
                    color: var(--ds-slate-400);
                }
                .ds-hint {
                    font-size: 0.75rem;
                    color: var(--ds-slate-500);
                    margin-top: 5px;
                }

                /* Section Divider */
                .ds-form-divider {
                    border-top: 1px solid var(--ds-slate-100);
                    margin: 24px 0 20px 0;
                }
                .ds-divider-title {
                    font-size: 0.6875rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: var(--ds-slate-400);
                    margin-bottom: 14px;
                }

                /* Submit Button */
                .ds-btn-submit {
                    width: 100%;
                    background-color: var(--ds-slate-900);
                    color: #ffffff;
                    border: 1px solid var(--ds-slate-900);
                    border-radius: 6px;
                    padding: 11px 20px;
                    font-size: 0.9375rem;
                    font-weight: 500;
                    cursor: pointer;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    transition: background-color 0.15s ease;
                }
                .ds-btn-submit:hover {
                    background-color: var(--ds-slate-800);
                    border-color: var(--ds-slate-800);
                }

                /* Alert */
                .ds-alert-error {
                    background-color: #fef2f2;
                    border: 1px solid #fecaca;
                    color: #991b1b;
                    font-size: 0.8125rem;
                    border-radius: 6px;
                    padding: 10px 14px;
                    margin-bottom: 20px;
                }
            </style>

            <div class="ds-onboarding-shell">
                <!-- Branding Header -->
                <div class="text-center mb-4">
                    <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                        <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect width="28" height="28" rx="6" fill="#0F172A"/>
                            <path d="M14 6L6 10.5L14 15L22 10.5L14 6Z" stroke="#34D399" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 14.5L14 19L22 14.5" stroke="#E2E8F0" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 18.5L14 23L22 18.5" stroke="#E2E8F0" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span style="font-size: 1rem; font-weight: 700; letter-spacing: -0.02em; color: var(--ds-slate-900);">DARSENTRA ERP</span>
                    </a>
                </div>

                <div class="ds-setup-card">
                    <div class="ds-setup-header">
                        <div class="ds-setup-step">
                            <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--ds-emerald);"/>
                            <span>Step 1 of 1 • School Workspace Profile</span>
                        </div>
                        <h1 class="ds-setup-title">Set up your school</h1>
                        <p class="ds-setup-subtitle">
                            Provide your institution's official details. These will appear on fee challans, admission registers, and computerized report cards.
                        </p>
                    </div>

                    <!-- Error Alert -->
                    <t t-if="error">
                        <div class="ds-alert-error" role="alert">
                            <span class="fw-semibold">Notice:</span> <t t-esc="error"/>
                        </div>
                    </t>

                    <!-- Form -->
                    <form action="/school/onboarding" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- Section: Identity -->
                        <div class="ds-divider-title">Institutional Identity</div>
                        
                        <div class="ds-form-group">
                            <label class="ds-label" for="school_name">
                                School / Institution Name <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="school_name"
                                   name="school_name"
                                   class="ds-input"
                                   placeholder="e.g. The Crescent Grammar High School"
                                   t-att-value="(form_data and form_data.get('school_name')) or (company and company.name if company and company.name != 'My Company' else '')"
                                   required="required"/>
                            <div class="ds-hint">Printed on all official 3-copy fee vouchers and character certificates.</div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 ds-form-group">
                                <label class="ds-label" for="school_city">
                                    Campus City <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       id="school_city"
                                       name="school_city"
                                       class="ds-input"
                                       placeholder="e.g. Lahore, Karachi, Rawalpindi"
                                       t-att-value="(form_data and form_data.get('school_city')) or (company and company.school_campus_city) or 'Lahore'"
                                       required="required"/>
                            </div>

                            <div class="col-md-6 ds-form-group">
                                <label class="ds-label" for="school_phone">
                                    Official Contact / WhatsApp <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       id="school_phone"
                                       name="school_phone"
                                       class="ds-input"
                                       placeholder="e.g. +92 300 1234567"
                                       t-att-value="(form_data and form_data.get('school_phone')) or (company and company.phone) or ''"
                                       required="required"/>
                            </div>
                        </div>

                        <!-- Section: Academic Structure -->
                        <div class="ds-form-divider"/>
                        <div class="ds-divider-title">Academic &amp; Board Affiliation</div>

                        <div class="row g-3">
                            <div class="col-md-6 ds-form-group">
                                <label class="ds-label" for="academic_session">
                                    Academic Session
                                </label>
                                <input type="text"
                                       id="academic_session"
                                       name="academic_session"
                                       class="ds-input"
                                       placeholder="e.g. 2025-2026"
                                       t-att-value="(form_data and form_data.get('academic_session')) or (company and company.academic_session) or '2025-2026'"/>
                            </div>

                            <div class="col-md-6 ds-form-group">
                                <label class="ds-label" for="school_board">
                                    Educational Board
                                </label>
                                <select id="school_board" name="school_board" class="ds-select">
                                    <option value="punjab" t-att-selected="(form_data and form_data.get('school_board') == 'punjab') or (company and company.school_board == 'punjab')">Punjab BISE (Lahore/Rwp/Fsd/Mul)</option>
                                    <option value="federal" t-att-selected="(form_data and form_data.get('school_board') == 'federal') or (company and company.school_board == 'federal')">Federal Board (FBISE Islamabad)</option>
                                    <option value="sindh" t-att-selected="(form_data and form_data.get('school_board') == 'sindh') or (company and company.school_board == 'sindh')">Sindh Board (Karachi/Hyd)</option>
                                    <option value="kpk" t-att-selected="(form_data and form_data.get('school_board') == 'kpk') or (company and company.school_board == 'kpk')">KPK Board (Peshawar/Abbottabad)</option>
                                    <option value="cambridge" t-att-selected="(form_data and form_data.get('school_board') == 'cambridge') or (company and company.school_board == 'cambridge')">Cambridge International (CAIE O/A)</option>
                                    <option value="other" t-att-selected="(form_data and form_data.get('school_board') == 'other') or (company and company.school_board == 'other')">Other Independent Board</option>
                                </select>
                            </div>
                        </div>

                        <div class="ds-form-group">
                            <label class="ds-label" for="school_level">
                                School Category
                            </label>
                            <select id="school_level" name="school_level" class="ds-select">
                                <option value="comprehensive" t-att-selected="(form_data and form_data.get('school_level') == 'comprehensive') or (company and company.school_level == 'comprehensive')">Comprehensive K-12 (Playgroup to Grade 10 / Matric / O-Levels)</option>
                                <option value="primary_middle" t-att-selected="(form_data and form_data.get('school_level') == 'primary_middle') or (company and company.school_level == 'primary_middle')">Primary &amp; Middle School (Playgroup - Grade 8)</option>
                                <option value="high_school" t-att-selected="(form_data and form_data.get('school_level') == 'high_school') or (company and company.school_level == 'high_school')">High School (Matric / SSC)</option>
                                <option value="cambridge" t-att-selected="(form_data and form_data.get('school_level') == 'cambridge') or (company and company.school_level == 'cambridge')">Cambridge System (O-Levels / A-Levels)</option>
                            </select>
                        </div>

                        <!-- Action Submit -->
                        <div class="mt-4 pt-2">
                            <button type="submit" class="ds-btn-submit">
                                <span>Complete Setup &amp; Open Dashboard</span>
                                <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>
