<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_darsentra_school_house_tree" model="ir.ui.view">
        <field name="name">darsentra.school.house.list</field>
        <field name="model">darsentra.school.house</field>
        <field name="arch" type="xml">
            <list string="School Houses">
                <field name="name"/>
                <field name="color_code" widget="color"/>
                <field name="motto"/>
                <field name="house_master_id"/>
                <field name="student_count"/>
            </list>
        </field>
    </record>

    <record id="view_darsentra_school_house_form" model="ir.ui.view">
        <field name="name">darsentra.school.house.form</field>
        <field name="model">darsentra.school.house</field>
        <field name="arch" type="xml">
            <form string="School House">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Jinnah House"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="color_code" widget="color"/>
                            <field name="motto"/>
                        </group>
                        <group>
                            <field name="house_master_id"/>
                            <field name="student_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_darsentra_school_house" model="ir.actions.act_window">
        <field name="name">School Houses</field>
        <field name="res_model">darsentra.school.house</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
