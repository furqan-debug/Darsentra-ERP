<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="landing_page" name="Darsentra School ERP Landing Page">
        <t t-call="web.frontend_layout">
            <t t-set="title">Darsentra — Modern School Management ERP for Pakistan</t>
            
            <style>
                :root {
                    --ds-font: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                    --ds-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
                    --ds-slate-900: #0f172a;
                    --ds-slate-800: #1e293b;
                    --ds-slate-700: #334155;
                    --ds-slate-600: #475569;
                    --ds-slate-500: #64748b;
                    --ds-slate-400: #94a3b8;
                    --ds-slate-200: #e2e8f0;
                    --ds-slate-100: #f1f5f9;
                    --ds-slate-50: #f8fafc;
                    --ds-emerald: #047857;
                    --ds-emerald-dark: #065f46;
                    --ds-emerald-light: #ecfdf5;
                }

                body {
                    font-family: var(--ds-font);
                    color: var(--ds-slate-900);
                    background-color: #ffffff;
                    -webkit-font-smoothing: antialiased;
                }

                /* Nav Header */
                .ds-nav-header {
                    border-bottom: 1px solid var(--ds-slate-200);
                    background: rgba(255, 255, 255, 0.92);
                    backdrop-filter: blur(12px);
                    -webkit-backdrop-filter: blur(12px);
                    position: sticky;
                    top: 0;
                    z-index: 1030;
                }
                .ds-brand-logo {
                    display: inline-flex;
                    align-items: center;
                    gap: 10px;
                    text-decoration: none;
                }
                .ds-brand-title {
                    font-size: 1.125rem;
                    font-weight: 700;
                    letter-spacing: -0.025em;
                    color: var(--ds-slate-900);
                }
                .ds-brand-tag {
                    font-size: 0.6875rem;
                    font-weight: 600;
                    letter-spacing: 0.04em;
                    text-transform: uppercase;
                    background: var(--ds-slate-100);
                    color: var(--ds-slate-600);
                    border: 1px solid var(--ds-slate-200);
                    padding: 2px 7px;
                    border-radius: 4px;
                }
                .ds-nav-link {
                    color: var(--ds-slate-600);
                    font-size: 0.875rem;
                    font-weight: 500;
                    text-decoration: none;
                    transition: color 0.15s ease;
                }
                .ds-nav-link:hover {
                    color: var(--ds-slate-900);
                }

                /* Buttons */
                .ds-btn-primary {
                    background-color: var(--ds-slate-900);
                    color: #ffffff !important;
                    font-size: 0.875rem;
                    font-weight: 500;
                    padding: 8px 16px;
                    border-radius: 6px;
                    border: 1px solid var(--ds-slate-900);
                    text-decoration: none;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    transition: all 0.15s ease;
                }
                .ds-btn-primary:hover {
                    background-color: var(--ds-slate-800);
                    border-color: var(--ds-slate-800);
                    color: #ffffff !important;
                }
                .ds-btn-emerald {
                    background-color: var(--ds-emerald);
                    color: #ffffff !important;
                    font-size: 0.9375rem;
                    font-weight: 600;
                    padding: 10px 20px;
                    border-radius: 6px;
                    border: 1px solid var(--ds-emerald);
                    text-decoration: none;
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    transition: all 0.15s ease;
                }
                .ds-btn-emerald:hover {
                    background-color: var(--ds-emerald-dark);
                    border-color: var(--ds-emerald-dark);
                    color: #ffffff !important;
                }
                .ds-btn-secondary {
                    background-color: #ffffff;
                    color: var(--ds-slate-700) !important;
                    font-size: 0.9375rem;
                    font-weight: 500;
                    padding: 10px 18px;
                    border-radius: 6px;
                    border: 1px solid var(--ds-slate-200);
                    text-decoration: none;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    transition: all 0.15s ease;
                }
                .ds-btn-secondary:hover {
                    background-color: var(--ds-slate-50);
                    border-color: #cbd5e1;
                    color: var(--ds-slate-900) !important;
                }

                /* Hero Section */
                .ds-hero-section {
                    padding: 72px 0 64px 0;
                    background: #ffffff;
                    border-bottom: 1px solid var(--ds-slate-200);
                }
                .ds-eyebrow {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    font-size: 0.8125rem;
                    font-weight: 500;
                    color: var(--ds-slate-700);
                    background: var(--ds-slate-50);
                    border: 1px solid var(--ds-slate-200);
                    border-radius: 9999px;
                    padding: 4px 14px;
                    margin-bottom: 20px;
                }
                .ds-status-dot {
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background-color: #10b981;
                }
                .ds-hero-title {
                    font-size: 3.25rem;
                    font-weight: 700;
                    letter-spacing: -0.035em;
                    line-height: 1.15;
                    color: var(--ds-slate-900);
                    max-width: 820px;
                    margin: 0 auto 20px auto;
                }
                @media (max-width: 768px) {
                    .ds-hero-title {
                        font-size: 2.25rem;
                    }
                }
                .ds-hero-subhead {
                    font-size: 1.125rem;
                    line-height: 1.6;
                    color: var(--ds-slate-500);
                    max-width: 680px;
                    margin: 0 auto 32px auto;
                }

                /* App Window Mockup */
                .ds-window-shell {
                    background: #ffffff;
                    border: 1px solid var(--ds-slate-200);
                    border-radius: 10px;
                    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -1px rgba(15, 23, 42, 0.04);
                    overflow: hidden;
                    max-width: 1080px;
                    margin: 0 auto;
                }
                .ds-window-bar {
                    background: var(--ds-slate-50);
                    border-bottom: 1px solid var(--ds-slate-200);
                    padding: 10px 16px;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                }
                .ds-window-controls {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }
                .ds-window-dot {
                    width: 10px;
                    height: 10px;
                    border-radius: 50%;
                }
                .ds-window-url {
                    font-family: var(--ds-mono);
                    font-size: 0.75rem;
                    color: var(--ds-slate-500);
                    background: #ffffff;
                    border: 1px solid var(--ds-slate-200);
                    border-radius: 4px;
                    padding: 3px 14px;
                }

                /* Mockup App Body */
                .ds-mock-metrics {
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    border-bottom: 1px solid var(--ds-slate-200);
                    background: #ffffff;
                }
                @media (max-width: 768px) {
                    .ds-mock-metrics {
                        grid-template-columns: repeat(2, 1fr);
                    }
                }
                .ds-metric-cell {
                    padding: 16px 20px;
                    border-right: 1px solid var(--ds-slate-200);
                }
                .ds-metric-cell:last-child {
                    border-right: none;
                }
                .ds-metric-label {
                    font-size: 0.75rem;
                    font-weight: 500;
                    color: var(--ds-slate-500);
                    margin-bottom: 4px;
                    text-transform: uppercase;
                    letter-spacing: 0.03em;
                }
                .ds-metric-val {
                    font-size: 1.25rem;
                    font-weight: 700;
                    color: var(--ds-slate-900);
                    display: flex;
                    align-items: baseline;
                    gap: 6px;
                }
                .ds-metric-badge {
                    font-size: 0.6875rem;
                    font-weight: 600;
                    color: #047857;
                    background: #ecfdf5;
                    padding: 1px 6px;
                    border-radius: 4px;
                }

                /* Mockup Data Table */
                .ds-mock-table {
                    width: 100%;
                    border-collapse: collapse;
                    font-size: 0.8125rem;
                    text-align: left;
                }
                .ds-mock-table th {
                    background: var(--ds-slate-50);
                    color: var(--ds-slate-500);
                    font-weight: 600;
                    font-size: 0.6875rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    padding: 10px 16px;
                    border-bottom: 1px solid var(--ds-slate-200);
                }
                .ds-mock-table td {
                    padding: 12px 16px;
                    border-bottom: 1px solid var(--ds-slate-100);
                    color: var(--ds-slate-700);
                    vertical-align: middle;
                }
                .ds-tag-success {
                    background: #ecfdf5;
                    color: #065f46;
                    font-size: 0.75rem;
                    font-weight: 500;
                    padding: 2px 8px;
                    border-radius: 4px;
                    border: 1px solid #a7f3d0;
                    display: inline-block;
                }
                .ds-tag-primary {
                    background: #eff6ff;
                    color: #1e40af;
                    font-size: 0.75rem;
                    font-weight: 500;
                    padding: 2px 8px;
                    border-radius: 4px;
                    border: 1px solid #bfdbfe;
                    display: inline-block;
                }
                .ds-tag-position {
                    background: #fffbeb;
                    color: #92400e;
                    font-size: 0.75rem;
                    font-weight: 600;
                    padding: 2px 8px;
                    border-radius: 4px;
                    border: 1px solid #fde68a;
                    display: inline-block;
                }

                /* Bento Features Grid */
                .ds-section-padding {
                    padding: 80px 0;
                }
                .ds-section-header {
                    margin-bottom: 48px;
                }
                .ds-section-eyebrow {
                    font-size: 0.75rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                    color: var(--ds-emerald);
                    margin-bottom: 8px;
                }
                .ds-section-title {
                    font-size: 2rem;
                    font-weight: 700;
                    letter-spacing: -0.025em;
                    color: var(--ds-slate-900);
                }
                .ds-section-desc {
                    font-size: 1rem;
                    color: var(--ds-slate-500);
                    max-width: 580px;
                }

                .ds-bento-grid {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    gap: 20px;
                }
                @media (max-width: 768px) {
                    .ds-bento-grid {
                        grid-template-columns: 1fr;
                    }
                }
                .ds-bento-card {
                    background: #ffffff;
                    border: 1px solid var(--ds-slate-200);
                    border-radius: 8px;
                    padding: 28px;
                    transition: border-color 0.15s ease;
                }
                .ds-bento-card:hover {
                    border-color: #cbd5e1;
                }
                .ds-icon-frame {
                    width: 36px;
                    height: 36px;
                    border-radius: 6px;
                    background: var(--ds-slate-50);
                    border: 1px solid var(--ds-slate-200);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: var(--ds-slate-800);
                    margin-bottom: 18px;
                }
                .ds-card-title {
                    font-size: 1.125rem;
                    font-weight: 600;
                    letter-spacing: -0.015em;
                    color: var(--ds-slate-900);
                    margin-bottom: 8px;
                }
                .ds-card-body {
                    font-size: 0.875rem;
                    line-height: 1.6;
                    color: var(--ds-slate-600);
                    margin-bottom: 18px;
                }
                .ds-spec-list {
                    list-style: none;
                    padding: 0;
                    margin: 0;
                    border-top: 1px solid var(--ds-slate-100);
                    padding-top: 14px;
                }
                .ds-spec-item {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    font-size: 0.8125rem;
                    color: var(--ds-slate-600);
                    margin-bottom: 8px;
                }
                .ds-spec-item:last-child {
                    margin-bottom: 0;
                }
                .ds-check-svg {
                    width: 14px;
                    height: 14px;
                    color: var(--ds-emerald);
                    flex-shrink: 0;
                }

                /* Comparison Matrix */
                .ds-table-matrix {
                    width: 100%;
                    border: 1px solid var(--ds-slate-200);
                    border-radius: 8px;
                    overflow: hidden;
                    font-size: 0.875rem;
                }
                .ds-matrix-row {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    border-bottom: 1px solid var(--ds-slate-200);
                }
                .ds-matrix-row:last-child {
                    border-bottom: none;
                }
                .ds-matrix-col-bad {
                    padding: 16px 20px;
                    background: #ffffff;
                    color: var(--ds-slate-500);
                    border-right: 1px solid var(--ds-slate-200);
                }
                .ds-matrix-col-good {
                    padding: 16px 20px;
                    background: var(--ds-slate-50);
                    color: var(--ds-slate-900);
                    font-weight: 500;
                }

                /* CTA Banner */
                .ds-cta-box {
                    background: var(--ds-slate-900);
                    border-radius: 8px;
                    padding: 56px 40px;
                    color: #ffffff;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    flex-wrap: wrap;
                    gap: 24px;
                }
                .ds-cta-title {
                    font-size: 1.875rem;
                    font-weight: 700;
                    letter-spacing: -0.025em;
                    color: #ffffff;
                    margin-bottom: 8px;
                }
                .ds-cta-text {
                    font-size: 1rem;
                    color: var(--ds-slate-400);
                    max-width: 540px;
                    margin-bottom: 0;
                }

                /* Footer */
                .ds-footer {
                    border-top: 1px solid var(--ds-slate-200);
                    padding: 40px 0;
                    background: #ffffff;
                    font-size: 0.8125rem;
                    color: var(--ds-slate-500);
                }
                .ds-footer a {
                    color: var(--ds-slate-600);
                    text-decoration: none;
                    transition: color 0.15s ease;
                }
                .ds-footer a:hover {
                    color: var(--ds-slate-900);
                }
            </style>

