<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_slc_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="padding: 30px; font-family: 'Times New Roman', serif;">
                    <!-- Elegant Certificate Border -->
                    <div style="border: 4px double #1e3a8a; padding: 25px; border-radius: 6px; min-height: 900px; position: relative;">
                        
                        <!-- School Header -->
                        <div class="text-center mb-4">
                            <h2 style="font-size: 26px; font-weight: bold; color: #1e3a8a; text-transform: uppercase; margin-bottom: 2px;">
                                <t t-esc="o.create_uid.company_id.name or 'DARSENTRA PUBLIC HIGH SCHOOL'"/>
                            </h2>
                            <div style="font-size: 13px; color: #475569;">
                                Registered &amp; Recognized by Directorate of Education / BISE
                            </div>
                            <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                                <t t-esc="o.create_uid.company_id.street"/>, <t t-esc="o.create_uid.company_id.city"/> | Phone: <t t-esc="o.create_uid.company_id.phone"/>
                            </div>
                            <div class="mt-3">
                                <span style="display: inline-block; padding: 6px 24px; border: 2px solid #1e3a8a; font-size: 18px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; background-color: #f8fafc;">
                                    SCHOOL LEAVING CERTIFICATE (SLC)
                                </span>
                            </div>
                        </div>

                        <!-- Certificate Meta -->
                        <div class="d-flex justify-content-between mb-4" style="font-size: 14px;">
                            <div><strong>Certificate Serial No:</strong> <span style="text-decoration: underline;"><t t-esc="o.certificate_number"/></span></div>
                            <div><strong>G.R. / Reg No:</strong> <span style="text-decoration: underline;"><t t-esc="o.gr_no or '-'"/></span></div>
                            <div><strong>Date of Issue:</strong> <span style="text-decoration: underline;"><t t-esc="o.issue_date"/></span></div>
                        </div>

                        <!-- Body Paragraphs -->
                        <div style="font-size: 15px; line-height: 2.2; text-align: justify; margin-top: 25px;">
                            This is to certify that Master / Miss 
                            <strong style="text-decoration: underline; padding: 0 8px; color: #1e3a8a;"><t t-esc="o.student_id.name"/></strong>,
                            Son / Daughter of 
                            <strong style="text-decoration: underline; padding: 0 8px;"><t t-esc="o.father_name or '-'"/></strong>,
                            bearing NADRA B-Form / CRC No.
                            <strong style="text-decoration: underline; padding: 0 8px;"><t t-esc="o.b_form or '-'"/></strong>,
                            was a bona fide student of this school.
                            <br/>
                            He / She was admitted to this institution on 
                            <strong style="text-decoration: underline; padding: 0 8px;"><t t-esc="o.date_of_admission or '-'"/></strong>,
                            and has left the school on 
                            <strong style="text-decoration: underline; padding: 0 8px;"><t t-esc="o.date_of_leaving or '-'"/></strong>.
                            <br/>
                            At the time of leaving, he / she was studying in 
                            <strong style="text-decoration: underline; padding: 0 8px; color: #1e3a8a;"><t t-esc="o.class_at_leaving.name or '-'"/> (<t t-esc="o.section_at_leaving.name or '-'"/>)</strong>.
                            <br/>
                            According to the school examination record: 
                            <strong style="text-decoration: underline; padding: 0 8px;"><t t-esc="o.class_promoted_to or 'Duly Promoted'"/></strong>.
                            <br/>
                            Reason for leaving school: 
                            <strong style="text-decoration: underline; padding: 0 8px;"><t t-esc="dict(o._fields['reason_for_leaving'].selection).get(o.reason_for_leaving)"/></strong>.
                            <br/>
                            General Conduct &amp; Character during stay: 
                            <strong style="text-decoration: underline; padding: 0 8px;"><t t-esc="dict(o._fields['conduct_and_character'].selection).get(o.conduct_and_character)"/></strong>.
                            <br/>
                            All school dues, tuition fees, and library books: 
                            <strong style="text-decoration: underline; padding: 0 8px; color: #15803d;">HAVE BEEN FULLY CLEARED</strong>.
                        </div>

                        <!-- Special Remarks -->
                        <div t-if="o.remarks" class="mt-4 p-2 bg-light border" style="font-size: 13px;">
                            <strong>Remarks:</strong> <t t-esc="o.remarks"/>
                        </div>

                        <!-- Signatures -->
                        <div class="row text-center" style="margin-top: 130px; font-size: 14px;">
                            <div class="col-4">
                                <div style="border-top: 1px solid #000; padding-top: 6px; font-weight: bold;">Class Incharge</div>
                            </div>
                            <div class="col-4">
                                <div style="border-top: 1px solid #000; padding-top: 6px; font-weight: bold;">Examination Incharge</div>
                            </div>
                            <div class="col-4">
                                <div style="border-top: 1px solid #000; padding-top: 6px; font-weight: bold;">Principal / Headmaster</div>
                                <div style="font-size: 11px; color: #64748b;">(Official Stamp &amp; Seal)</div>
                            </div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
