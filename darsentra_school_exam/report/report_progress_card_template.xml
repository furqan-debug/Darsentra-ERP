<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_progress_card_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="padding: 25px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
                    <!-- Report Card Border -->
                    <div style="border: 3px solid #1e3a8a; padding: 20px; border-radius: 8px; min-height: 900px;">
                        
                        <!-- School Header -->
                        <div class="text-center mb-3 pb-2 border-bottom border-primary">
                            <h2 style="font-size: 24px; font-weight: bold; color: #1e3a8a; text-transform: uppercase; margin-bottom: 2px;">
                                <t t-esc="o.create_uid.company_id.name or 'DARSENTRA PUBLIC HIGH SCHOOL'"/>
                            </h2>
                            <div style="font-size: 12px; color: #475569;">
                                Academic Session &amp; Examination Record
                            </div>
                            <div class="mt-2">
                                <span class="badge bg-primary text-white px-3 py-2 text-uppercase" style="font-size: 14px; letter-spacing: 1px;">
                                    TERM PROGRESS REPORT CARD
                                </span>
                            </div>
                        </div>

                        <!-- Student Metadata Box -->
                        <div class="bg-light p-3 border rounded mb-3" style="font-size: 13px;">
                            <div class="row g-2">
                                <div class="col-6">
                                    <strong>Student Name:</strong> <span class="text-primary fw-bold ms-1"><t t-esc="o.student_id.name"/></span>
                                </div>
                                <div class="col-6">
                                    <strong>Roll No / G.R:</strong> <span class="ms-1"><t t-esc="o.student_id.gr_no or '-'"/></span>
                                </div>
                                <div class="col-6">
                                    <strong>Father's Name:</strong> <span class="ms-1"><t t-esc="o.father_name or '-'"/></span>
                                </div>
                                <div class="col-6">
                                    <strong>B-Form / CRC:</strong> <span class="ms-1"><t t-esc="o.student_b_form or '-'"/></span>
                                </div>
                                <div class="col-6">
                                    <strong>Class (Grade):</strong> <span class="ms-1"><t t-esc="o.class_id.name or '-'"/></span>
                                </div>
                                <div class="col-6">
                                    <strong>Section:</strong> <span class="ms-1"><t t-esc="o.section_id.name or '-'"/></span>
                                </div>
                            </div>
                        </div>

                        <!-- Subject Results Table -->
                        <table class="table table-bordered table-striped text-center mb-3" style="font-size: 12px;">
                            <thead class="table-primary">
                                <tr>
                                    <th class="text-start" style="width: 35%;">Subject</th>
                                    <th>Total Marks</th>
                                    <th>Pass Marks</th>
                                    <th>Marks Obtained</th>
                                    <th>Grade</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.result_line" t-as="res">
                                    <td class="text-start fw-bold"><t t-esc="res.exam_id.subject_id.name"/></td>
                                    <td><t t-esc="res.exam_id.total_marks or 100"/></td>
                                    <td><t t-esc="res.exam_id.passing_marks or 33"/></td>
                                    <td class="fw-bold"><t t-esc="res.marks"/></td>
                                    <td><t t-esc="res.grade or '-'"/></td>
                                    <td>
                                        <span t-if="res.status == 'pass'" class="badge bg-success text-white">Pass</span>
                                        <span t-else="" class="badge bg-danger text-white">Fail</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Performance & Ranking Summary -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="border rounded p-2 text-center bg-light">
                                    <div class="text-muted" style="font-size: 11px;">TOTAL OBTAINED</div>
                                    <div class="fs-4 fw-bold text-primary">
                                        <t t-esc="o.total_marks"/>
                                    </div>
                                    <div style="font-size: 12px;">Percentage: <strong><t t-esc="'{:.1f}%'.format(o.percentage)"/></strong></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded p-2 text-center" style="background-color: #fefce8; border-color: #fde047 !important;">
                                    <div class="text-muted" style="font-size: 11px;">CLASS RANK / POSITION</div>
                                    <div class="fs-4 fw-bold" style="color: #ca8a04;">
                                        <t t-esc="o.class_position or 'Pass'"/>
                                    </div>
                                    <div style="font-size: 12px;">Overall Grade: <strong><t t-esc="o.school_grade or '-'"/></strong></div>
                                </div>
                            </div>
                        </div>

                        <!-- Teacher Remarks & Attendance -->
                        <div class="border rounded p-2 mb-4 bg-light" style="font-size: 12px;">
                            <div class="d-flex justify-content-between mb-1">
                                <div><strong>Attendance in Term:</strong> <t t-esc="o.term_attendance_percentage"/>%</div>
                                <div><strong>Final Result:</strong> <span class="badge bg-success text-white">PROMOTED</span></div>
                            </div>
                            <div>
                                <strong>Class Teacher's Remarks:</strong> 
                                <em>"<t t-esc="o.teacher_remarks"/>"</em>
                            </div>
                        </div>

                        <!-- Grading Key -->
                        <div class="p-2 border rounded mb-5" style="font-size: 9px; color: #475569; background-color: #f8fafc;">
                            <strong>Grading Criteria:</strong> A+ (80% and above - Outstanding) | A (70-79% - Excellent) | B (60-69% - Very Good) | C (50-59% - Good) | D (40-49% - Fair) | E (33-39% - Pass) | F (Below 33% - Fail)
                        </div>

                        <!-- Signatures -->
                        <div class="row text-center mt-5" style="font-size: 12px;">
                            <div class="col-4">
                                <div style="border-top: 1px solid #000; width: 75%; margin: 0 auto; padding-top: 5px; font-weight: bold;">Class Teacher</div>
                            </div>
                            <div class="col-4">
                                <div style="border-top: 1px solid #000; width: 75%; margin: 0 auto; padding-top: 5px; font-weight: bold;">Examination Incharge</div>
                            </div>
                            <div class="col-4">
                                <div style="border-top: 1px solid #000; width: 75%; margin: 0 auto; padding-top: 5px; font-weight: bold;">Principal / Headmaster</div>
                                <div style="font-size: 10px; color: #64748b;">(Official Stamp)</div>
                            </div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
