# ==============================================================================
# Darsentra ERP - Root Environment Variables Template
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=darsentra_erp
POSTGRES_USER=darsentra_user
POSTGRES_PASSWORD=darsentra_secure_password_replace_in_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Backend Configuration
DJANGO_SECRET_KEY=insecure-development-secret-key-change-in-production-1234567890
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_URL=http://localhost:8000
